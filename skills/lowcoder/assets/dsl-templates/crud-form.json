{
  "_description": "Form de creación: input + input + select + button con disabled condicional",
  "_components": [
    { "id": "nameInput", "type": "input", "options": { "label": "Nombre", "required": true }, "layout": { "x": 0, "y": 0, "w": 8, "h": 8 } },
    { "id": "emailInput", "type": "input", "options": { "label": "Email", "placeholder": "user@example.com" }, "layout": { "x": 8, "y": 0, "w": 8, "h": 8 } },
    { "id": "roleSelect", "type": "select", "options": { "label": "Rol", "options": [{ "label": "Admin", "value": "admin" }, { "label": "Editor", "value": "editor" }, { "label": "Viewer", "value": "viewer" }], "defaultValue": "viewer" }, "layout": { "x": 16, "y": 0, "w": 4, "h": 8 } },
    { "id": "createBtn", "type": "button", "options": { "text": "Crear", "type": "submit", "onClick": "createUser", "disabled": "{{!nameInput.value || !emailInput.value}}", "loading": "{{createUser.isFetching}}" }, "layout": { "x": 20, "y": 0, "w": 4, "h": 8 } }
  ]
}
